// This file is automatically generated by Keystone, do not modify it manually.
// Modify your Keystone config when you want to change this.

datasource mysql {
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  provider          = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(cuid())
  name      String    @default("")
  email     String    @unique @default("")
  password  String
  createdAt DateTime? @default(now())
}

model Podcast {
  id           String    @id @default(cuid())
  rssFeedUrl   String    @unique @default("")
  isFeatured   Boolean   @default(false)
  featuredAt   DateTime? @default(now())
  categories   String    @default("")
  keywords     String    @default("")
  syncTime     String    @default("")
  lastSyncedAt DateTime?
  title        String    @default("")
  slug         String    @unique @default("")
  description  String    @default("") @mysql.LongText
  imageUrl     String    @default("")
  episodes     Episode[] @relation("Episode_podcast")
  createdAt    DateTime? @default(now())
  updatedAt    DateTime? @default(now())

  @@index([updatedAt])
}

model Episode {
  id          String    @id @default(cuid())
  season      Int
  episode     Int
  title       String    @default("")
  description String    @default("") @mysql.LongText
  imageUrl    String    @default("")
  audioUrl    String    @default("") @mysql.LongText
  releaseDate DateTime?
  duration    Int?
  podcast     Podcast?  @relation("Episode_podcast", fields: [podcastId], references: [id])
  podcastId   String?   @map("podcast")
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @default(now())

  @@index([podcastId])
  @@index([updatedAt])
}
